# Локальный API
MINIKV_DATA_FILE=data/data.json
MINIKV_PORT=8000

# Роль и репликация узла
MINIKV_NODE_ROLE=primary
MINIKV_REPLICATION_LOG=data/data.json.operations.jsonl
MINIKV_PRIMARY_URL=http://localhost:8001
MINIKV_PEER_URL=http://localhost:8002
MINIKV_REPLICATION_POLL_INTERVAL=1.0
MINIKV_REPLICATION_BATCH_SIZE=100
MINIKV_REPLICATION_REQUEST_TIMEOUT=5.0
MINIKV_AUTOMATIC_FAILOVER=false
MINIKV_FAILOVER_TIMEOUT=5.0

# Маршрутизатор сегментов
MINIKV_ROUTER_PORT=8000
MINIKV_SHARD_0_ID=shard-0
MINIKV_SHARD_0_URL=http://shard-0-primary:8000
MINIKV_SHARD_0_REPLICA_URL=http://shard-0-replica:8000
MINIKV_SHARD_1_ID=shard-1
MINIKV_SHARD_1_URL=http://shard-1-primary:8000
MINIKV_SHARD_1_REPLICA_URL=http://shard-1-replica:8000
MINIKV_SHARD_REQUEST_TIMEOUT=5.0

# Публикуемые порты Docker Compose
MINIKV_SHARD_0_PRIMARY_PORT=8001
MINIKV_SHARD_0_REPLICA_PORT=8002
MINIKV_SHARD_1_PRIMARY_PORT=8003
MINIKV_SHARD_1_REPLICA_PORT=8004
